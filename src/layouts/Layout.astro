---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}
const {
	title = 'Abogada en Xalapa, Veracruz | Amparo, Laboral y Fiscal | Iliria Viveros',
	description = 'Despacho jurídico en Xalapa, Veracruz. Iliria Viveros, abogada y maestra en amparo: derecho laboral, defensa fiscal ante el SAT y cumplimiento normativo para personas y empresas.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/iliria-viveros-favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/iliria-viveros-favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="geo.region" content="MX-VER" />
		<meta name="geo.placename" content="Xalapa, Veracruz" />

		<link rel="canonical" href={new URL(Astro.url.pathname, 'https://iliriaviveros.com').href} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- Open Graph / Redes Sociales -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="es_MX" />
		<meta property="og:url" content={new URL(Astro.url.pathname, 'https://iliriaviveros.com').href} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="https://iliriaviveros.com/images/hero.png" />
		<meta name="twitter:card" content="summary_large_image" />
		
		<!-- Marcado Estructurado JSON-LD -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LegalService",
			"name": "Iliria Hernández Viveros - Consultora Jurídica",
			"image": "https://iliriaviveros.com/images/hero.png",
			"url": "https://iliriaviveros.com",
			"telephone": "+522281346921",
			"email": "iliriaviveros@gmail.com",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": "Calle Chopin S/N, Col. Indeco Ánimas",
				"addressLocality": "Xalapa-Enríquez",
				"addressRegion": "Veracruz",
				"postalCode": "91190",
				"addressCountry": "MX"
			},
			"geo": {
				"@type": "GeoCoordinates",
				"latitude": 19.5438,
				"longitude": -96.9102
			},
			"areaServed": [
				{ "@type": "City", "name": "Xalapa" },
				{ "@type": "State", "name": "Veracruz" },
				{ "@type": "Country", "name": "México" }
			],
			"knowsAbout": ["Juicio de Amparo", "Derecho Laboral", "Derecho Fiscal", "Derecho Administrativo"]
		}
		</script>
	</head>
	<body>
		<a class="skip" href="#contenido">Saltar al contenido</a>
		<header class="site-header">
			<a class="brand" href="/">Iliria Viveros</a>
			<nav class="nav" aria-label="Navegación principal">
				<a href="/">Inicio</a>
				<a href="#areas">Áreas de práctica</a>
				<a href="#enfoque">Enfoque</a>
				<a href="#contacto">Contacto</a>
				<a class="nav-cta" href="#contacto">Plantear mi asunto <span aria-hidden="true">&rarr;</span></a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<strong>Iliria Viveros</strong>
					<p>Defensa cuidadosa y estrategia jurídica.</p>
					<div class="footer-contact-info" style="margin-top: 16px;">
						<address style="font-style: normal; font-size: 14px; margin-bottom: 8px; line-height: 1.5;">📍 Calle Chopin S/N, Col. Indeco Ánimas<br />Xalapa-Enríquez, Veracruz</address>
						<a href="mailto:iliriaviveros@gmail.com" style="display: block; font-size: 14px; margin-bottom: 4px;">✉ iliriaviveros@gmail.com</a>
						<a href="tel:+522281346921" style="display: block; font-size: 14px; margin-bottom: 4px;">☎ 228 134 6921</a>
						<a href="https://hamurabi.org" target="_blank" rel="noopener noreferrer" style="display: block; font-size: 14px; font-weight: 500; margin-top: 12px;">Red Hamurabi &rarr;</a>
					</div>
				</div>
				<div class="footer-links">
					<a href="#areas">Áreas de práctica</a>
					<a href="#trayectoria">Trayectoria</a>
					<a href="#contacto">Contacto</a>
				</div>
				<div class="footer-legal">
					<p>&copy; {new Date().getFullYear()} Iliria Hernández Viveros. Todos los derechos reservados.</p>
					<a href="/privacidad">Aviso de privacidad</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.skip { position: absolute; left: -9999px; top: 8px; background: #fff; padding: 12px; z-index: 200; }
	.skip:focus { left: 8px; }
	
	.site-header {
		height: 76px;
		padding: 0 clamp(24px, 4.1vw, 64px);
		display: flex;
		align-items: center;
		gap: 28px;
		border-bottom: 1px solid var(--line);
		background: rgba(250, 247, 244, .96);
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(8px);
	}
	
	.brand {
		font: 400 clamp(25px, 2.1vw, 34px)/1 var(--serif);
		text-decoration: none;
		white-space: nowrap;
		color: var(--ink);
	}
	
	.nav {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: clamp(16px, 2vw, 35px);
		font-size: 16px;
	}
	
	.nav a:not(.nav-cta) {
		text-decoration: none;
		white-space: nowrap;
		color: var(--ink);
	}
	.nav a:hover {
		text-decoration: underline;
		text-underline-offset: 7px;
	}
	
	.nav-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		background: var(--brand);
		color: white !important;
		text-decoration: none !important;
		text-transform: uppercase;
		letter-spacing: .15em;
		font-weight: 700;
		font-size: 13px;
		padding: 18px 27px;
		transition: background .18s;
	}
	.nav-cta:hover { background: var(--brand-dark); }
	
	@media(max-width:1020px) {
		.nav { gap: 15px; }
		.nav a:not(.nav-cta) { display: none; }
	}
	@media(max-width:700px) {
		.site-header { height: 66px; padding-inline: 20px; }
		.brand { font-size: 25px; }
		.nav-cta { padding: 13px 14px; font-size: 10px; letter-spacing: .08em; }
	}
	@media(max-width:420px) {
		.nav-cta { font-size: 0; gap: 0; }
		.nav-cta::after { content: 'Contacto'; font-size: 11px; }
	}

	.site-footer {
		background-color: var(--brand-dark);
		color: var(--color-surface);
		padding: 64px 0 32px;
	}

	.footer-inner {
		display: grid;
		gap: 32px;
	}

	@media (min-width: 768px) {
		.footer-inner {
			grid-template-columns: 2fr 1fr 1fr;
		}
	}

	.footer-brand p {
		margin-top: 8px;
		font-size: 14px;
		color: rgba(255,255,255,0.7);
	}

	.footer-contact-info a, .footer-links a, .footer-legal a {
		color: var(--color-surface);
		text-decoration: none;
	}
	.footer-contact-info a:hover, .footer-links a:hover, .footer-legal a:hover {
		text-decoration: underline;
	}

	.footer-links, .footer-legal {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-links a, .footer-legal a {
		font-size: 14px;
	}

	.footer-legal p {
		font-size: 12px;
		color: rgba(255,255,255,0.5);
	}
</style>
