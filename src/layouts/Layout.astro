---
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/iliria-viveros-favicon.ico" />
		<link rel="icon" type="image/svg+xml" href="/iliria-viveros-favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Iliria Viveros | Abogada y Maestra en Amparo</title>
		<meta name="description" content="Estrategia jurídica para asuntos que requieren una defensa cuidadosa. Amparo, derecho laboral y fiscal." />

		<!-- Open Graph / Redes Sociales -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://iliriaviveros.com/" />
		<meta property="og:title" content="Iliria Viveros | Defensa Legal" />
		<meta property="og:description" content="Abogada especialista en amparo, derecho laboral y defensa administrativa/fiscal. Consulta tu caso hoy." />
		<meta property="og:image" content="/images/hero.png" />
		
		<!-- Marcado Estructurado JSON-LD -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LegalService",
			"name": "Iliria Hernández Viveros - Consultora Jurídica",
			"image": "https://iliriaviveros.com/images/hero.png",
			"url": "https://iliriaviveros.com",
			"telephone": "+525581807624",
			"email": "iliriaviveros@gmail.com",
			"address": {
				"@type": "PostalAddress",
				"addressCountry": "MX"
			},
			"areaServed": "México",
			"knowsAbout": ["Juicio de Amparo", "Derecho Laboral", "Derecho Fiscal", "Derecho Administrativo"]
		}
		</script>
	</head>
	<body>
		<header class="site-header">
			<div class="container header-inner">
				<a href="/" class="brand" style="text-decoration: none;">Iliria Viveros</a>
				<nav class="main-nav">
					<a href="#" aria-current="page">Inicio</a>
					<a href="#areas">Áreas de práctica</a>
					<a href="#trayectoria">Trayectoria</a>
					<a href="#contacto" class="btn-primary">Plantear mi asunto</a>
				</nav>
			</div>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="container footer-inner">
				<div class="footer-brand">
					<strong>Iliria Viveros</strong>
					<p>Defensa cuidadosa y estrategia jurídica.</p>
					<div class="footer-contact-info" style="margin-top: 16px;">
						<a href="mailto:iliriaviveros@gmail.com" style="display: block; font-size: 14px; margin-bottom: 4px;">✉ iliriaviveros@gmail.com</a>
						<a href="tel:+525581807624" style="display: block; font-size: 14px; margin-bottom: 4px;">☎ 55 8180 7624</a>
						<a href="https://hamurabi.org" target="_blank" rel="noopener noreferrer" style="display: block; font-size: 14px; font-weight: 500; margin-top: 12px;">Red Hamurabi &rarr;</a>
					</div>
				</div>
				<div class="footer-links">
					<a href="#areas">Áreas de práctica</a>
					<a href="#trayectoria">Trayectoria</a>
					<a href="#contacto">Contacto</a>
				</div>
				<div class="footer-legal">
					<p>&copy; {new Date().getFullYear()} Iliria Hernández Viveros. Todos los derechos reservados.</p>
					<a href="/privacidad">Aviso de privacidad</a>
				</div>
			</div>
		</footer>
	</body>
</html>

<style>
	.skip { position: absolute; left: -9999px; top: 8px; background: #fff; padding: 12px; z-index: 200; }
	.skip:focus { left: 8px; }
	
	.site-header {
		height: 76px;
		padding: 0 clamp(24px, 4.1vw, 64px);
		display: flex;
		align-items: center;
		gap: 28px;
		border-bottom: 1px solid var(--line);
		background: rgba(250, 247, 244, .96);
		position: sticky;
		top: 0;
		z-index: 100;
		backdrop-filter: blur(8px);
	}
	
	.brand {
		font: 400 clamp(25px, 2.1vw, 34px)/1 var(--serif);
		text-decoration: none;
		white-space: nowrap;
		color: var(--ink);
	}
	
	.nav {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: clamp(16px, 2vw, 35px);
		font-size: 13px;
	}
	
	.nav a:not(.nav-cta) {
		text-decoration: none;
		white-space: nowrap;
		color: var(--ink);
	}
	.nav a:hover {
		text-decoration: underline;
		text-underline-offset: 7px;
	}
	
	.nav-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 18px;
		background: var(--brand);
		color: white !important;
		text-decoration: none !important;
		text-transform: uppercase;
		letter-spacing: .18em;
		font-weight: 700;
		font-size: 11px;
		padding: 18px 27px;
		transition: background .18s;
	}
	.nav-cta:hover { background: var(--brand-dark); }
	
	@media(max-width:1020px) {
		.nav { gap: 15px; }
		.nav a:not(.nav-cta) { display: none; }
	}
	@media(max-width:700px) {
		.site-header { height: 66px; padding-inline: 20px; }
		.brand { font-size: 25px; }
		.nav-cta { padding: 13px 14px; font-size: 10px; letter-spacing: .08em; }
	}
	@media(max-width:420px) {
		.nav-cta { font-size: 0; gap: 0; }
		.nav-cta::after { content: 'Contacto'; font-size: 11px; }
	}

	.site-footer {
		background-color: var(--brand-dark);
		color: var(--color-surface);
		padding: 64px 0 32px;
	}

	.footer-inner {
		display: grid;
		gap: 32px;
	}

	@media (min-width: 768px) {
		.footer-inner {
			grid-template-columns: 2fr 1fr 1fr;
		}
	}

	.footer-brand p {
		margin-top: 8px;
		font-size: 14px;
		color: rgba(255,255,255,0.7);
	}

	.footer-contact-info a, .footer-links a, .footer-legal a {
		color: var(--color-surface);
		text-decoration: none;
	}
	.footer-contact-info a:hover, .footer-links a:hover, .footer-legal a:hover {
		text-decoration: underline;
	}

	.footer-links, .footer-legal {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.footer-links a, .footer-legal a {
		font-size: 14px;
	}

	.footer-legal p {
		font-size: 12px;
		color: rgba(255,255,255,0.5);
	}
</style>
