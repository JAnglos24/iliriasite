---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<section class="error-page" style="text-align: center; padding: 120px 20px; min-height: 70vh; display: flex; flex-direction: column; justify-content: center; align-items: center;">
		<h1 style="font-size: 120px; color: var(--color-brand-600); margin-bottom: 24px; line-height: 1;">404</h1>
		<h2 style="margin-bottom: 16px;">Página no encontrada</h2>
		<p style="color: var(--color-muted); max-width: 500px; margin: 0 auto 32px auto;">La página que estás buscando no existe, fue movida o ocurrió un error inesperado.</p>
		<a href="/" class="btn-primary">Regresar al inicio</a>
	</section>
</Layout>
